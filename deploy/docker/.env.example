# 复制成 .env 再改；这个文件本身可以入库，真实口令放 .env（已 gitignore）

# 镜像：官方 ghcr.io/bearisbug/imbo-server:latest，或本机构建的 imbo-server:ntfy
IMBO_IMAGE=imbo-server:ntfy

# 对外端口（只监听 127.0.0.1，公网入口交给 Tailscale 或反向代理）
IMBO_PORT=8080
NTFY_PORT=8081

# 发验证码的 SMTP。不配就没人能收到验证码。
# 例：smtps://user:pass@smtp.example.com:465
IMBO_SMTP_URL=

# 先设 1 把服务跑通（验证码打进 docker logs）；配好 SMTP 后改成 0，否则邮件发不出去
IMBO_MAIL_LOG_ONLY=1

# 只允许这些邮箱域注册，逗号分隔；留空不限制
IMBO_SIGNUP_EMAIL_DOMAINS=

# ntfy 开了访问控制才需要；内网实例留空
IMBO_NTFY_TOKEN=

# 公网域名 + Let's Encrypt（不用 Tailscale、直接暴露 443 时才填）
IMBO_DOMAIN=
IMBO_ACME_EMAIL=

# 商店审核用的固定验证码（只在需要时开）
IMBO_REVIEW_EMAIL=
IMBO_REVIEW_CODE=

# 1 = 开发模式（打印更多日志、放宽某些限制）
IMBO_DEV=0
