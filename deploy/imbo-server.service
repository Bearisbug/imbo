[Unit]
Description=Imbo server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=imbo
Group=imbo
EnvironmentFile=/etc/imbo/server.env
WorkingDirectory=/var/lib/imbo
ExecStart=/opt/imbo/current/imbo-server serve
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/imbo
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
