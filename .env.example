# imbo-server 收款用的 Waffo 商户 ID（配置，非密钥）；六个 IMBO_WAFFO_* 要么全设、要么全不设 | 获取：Waffo 后台 Developers | 部署层：服务器 /etc/imbo/server.env（现在不设，线上不收费）
IMBO_WAFFO_MERCHANT_ID=MER_6AB5i2EKvRW2bYXYpYnFPR
# 收款店铺 ID（配置，非密钥） | 获取：Waffo 后台 Stores | 部署层：服务器 /etc/imbo/server.env（现在不设，线上不收费）
IMBO_WAFFO_STORE_ID=STO_2Wn6wV82T3eH4k9C4fyuvz
# Waffo API 私钥，单行 base64 或 PEM；建时绑定测试或正式环境，要与 IMBO_WAFFO_ENV 一致 | 获取：Bitwarden IMBO_WAFFO_TEST_PRIVATE_KEY（测试）、IMBO_WAFFO_PROD_PRIVATE_KEY（正式） | 部署层：服务器 /etc/imbo/server.env（现在不设，线上不收费）
IMBO_WAFFO_PRIVATE_KEY=
# 收款环境，test 只收测试卡，prod 真扣钱（配置，非密钥） | 获取：收费上线时设 prod | 部署层：服务器 /etc/imbo/server.env（现在不设，线上不收费）
IMBO_WAFFO_ENV=test
# 月付 2 美元套餐的 Waffo 商品 ID（配置，非密钥） | 获取：Waffo 后台 Products，测试环境的 Imbo monthly | 部署层：服务器 /etc/imbo/server.env（现在不设，线上不收费）
IMBO_WAFFO_PRODUCT_MONTHLY=PROD_3eEX6t7or9rfen01IivKto
# 年付 20 美元套餐的 Waffo 商品 ID（配置，非密钥） | 获取：Waffo 后台 Products，测试环境的 Imbo yearly | 部署层：服务器 /etc/imbo/server.env（现在不设，线上不收费）
IMBO_WAFFO_PRODUCT_YEARLY=PROD_7g8P6Z0bIdkpCwNw8eDvzm
# 计费开始日，如 2026-11-01，不设则人人免费（配置，非密钥） | 获取：用户定 | 部署层：服务器 /etc/imbo/server.env（现在不设）
IMBO_BILLING_START=
# 网页地址，只对它放行带 cookie 的跨域请求（配置，非密钥） | 获取：固定为 https://app.imbo.dev | 部署层：服务器 /etc/imbo/server.env
IMBO_WEB_ORIGIN=https://app.imbo.dev
# 客户端最低版本，比它旧的 imbo 停止收发并提示 `imbo update`，不设为 0.1.0（配置，非密钥） | 获取：发了不兼容旧客户端的服务端时定 | 部署层：服务器 /etc/imbo/server.env（现在不设）
IMBO_MIN_CLIENT_VERSION=
# 管理员的登录邮箱，逗号分隔；用这些邮箱在网页登录的人能进管理端，不设则没有管理员（配置，非密钥） | 获取：用户定 | 部署层：服务器 /etc/imbo/server.env
IMBO_ADMIN_EMAILS=
# 收举报通知的邮箱，也写进封禁提示里供申诉；不设则举报只记日志、不发信（配置，非密钥） | 获取：用户定 | 部署层：服务器 /etc/imbo/server.env
IMBO_REPORT_EMAIL=
# 商店审核人员登录用的邮箱，给它要验证码时不发信、用 IMBO_REVIEW_CODE；与它两个都设才生效（配置，非密钥） | 获取：用户定 | 部署层：服务器 /etc/imbo/server.env
IMBO_REVIEW_EMAIL=
# 审核邮箱的固定验证码，6 位数字，填进 App Store Connect 的审核登录信息 | 获取：生成 | 部署层：服务器 /etc/imbo/server.env
IMBO_REVIEW_CODE=
# Expo 推送服务的访问令牌；Expo 项目开了推送增强安全才要，没开就不设 | 获取：expo.dev 上 @imbo/imbo 的 Access tokens 里新建，存进 Bitwarden IMBO_EXPO_ACCESS_TOKEN | 部署层：服务器 /etc/imbo/server.env（现在不设）
IMBO_EXPO_ACCESS_TOKEN=
# 设 1 时不调 Expo，把要推的通知写进服务端日志，只在本地测试用（配置，非密钥） | 获取：本地测试时设 1 | 部署层：仅本地（不部署）
IMBO_PUSH_LOG_ONLY=
# App 的包名，App Store 收款用；七个 IMBO_APPLE_* 要么全设、要么全不设，且只在配了 Waffo 时生效（配置，非密钥） | 获取：固定为 dev.imbo.app | 部署层：服务器 /etc/imbo/server.env（现在不设，App 内购上线时设）
IMBO_APPLE_BUNDLE_ID=dev.imbo.app
# App 的数字 Apple ID，用来核对 Apple 的通知（配置，非密钥） | 获取：App Store Connect 里这个 App 的「App 信息」→ Apple ID | 部署层：服务器 /etc/imbo/server.env（现在不设，App 内购上线时设）
IMBO_APPLE_APP_ID=
# 月付订阅的商品 ID（配置，非密钥） | 获取：App Store Connect 的订阅商品，与 mobile/storekit/Imbo.storekit 一致 | 部署层：服务器 /etc/imbo/server.env（现在不设，App 内购上线时设）
IMBO_APPLE_PRODUCT_MONTHLY=dev.imbo.app.monthly
# 年付订阅的商品 ID（配置，非密钥） | 获取：App Store Connect 的订阅商品，与 mobile/storekit/Imbo.storekit 一致 | 部署层：服务器 /etc/imbo/server.env（现在不设，App 内购上线时设）
IMBO_APPLE_PRODUCT_YEARLY=dev.imbo.app.yearly
# App 内购买密钥的 Key ID，向 App Store Server API 查订阅时签名用（配置，非密钥） | 获取：App Store Connect「用户和访问」→「集成」→「App 内购买」 | 部署层：服务器 /etc/imbo/server.env（现在不设，App 内购上线时设）
IMBO_APPLE_KEY_ID=
# 上面那把密钥的 Issuer ID（配置，非密钥） | 获取：App Store Connect「用户和访问」→「集成」页顶部 | 部署层：服务器 /etc/imbo/server.env（现在不设，App 内购上线时设）
IMBO_APPLE_ISSUER_ID=
# App 内购买密钥的 .p8 内容（PKCS#8 PEM） | 获取：同一页生成后只能下载一次，存进 Bitwarden IMBO_APPLE_PRIVATE_KEY | 部署层：服务器 /etc/imbo/server.env（现在不设，App 内购上线时设）
IMBO_APPLE_PRIVATE_KEY=
# 本机测试用的根证书文件，换掉内置的 Apple 根证书；只在 IMBO_DEV=1 时生效（配置，非密钥） | 获取：scripts/apple-env.sh 生成 | 部署层：仅本地（不部署）
IMBO_APPLE_ROOT_CERT=
# 本机测试用的假 Apple 服务地址；只在 IMBO_DEV=1 时生效（配置，非密钥） | 获取：scripts/apple-env.sh 设为 http://127.0.0.1:18091 | 部署层：仅本地（不部署）
IMBO_APPLE_API_URL=
